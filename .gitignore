# Generated audio. Reproducible from the seed recorded in the manifest, and too
# large to be worth versioning. See README for the regeneration command.
app/assets/tracks/*.mp3
app/assets/tracks/*.wav

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets. The Xeno-canto key is personal and must never reach a public repo.
.env

# Cached Xeno-canto downloads. Re-fetchable from the identifiers pinned in
# generator/recordings.json, and too large to be worth versioning.
generator/recordings/
