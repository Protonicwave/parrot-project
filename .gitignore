# Intermediate WAV output. Reproducible from the seed recorded in the manifest.
# The MP3s are versioned: the site serves them, and at 5.75 MB the set is no
# longer large enough for the download to be worth the deploy machinery.
app/assets/tracks/*.wav

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets. The Xeno-canto key is personal and must never reach a public repo.
.env

# Cached Xeno-canto downloads. Re-fetchable from the identifiers pinned in
# generator/recordings.json, and too large to be worth versioning.
generator/recordings/

# Assembled design canvases. Rebuilt from the .dc.html artboards beside them.
docs/design/**/sunflower-guard-*.html
